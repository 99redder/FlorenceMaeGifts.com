name = "fmg-stripe-api"
main = "src/worker.js"
compatibility_date = "2026-02-12"

# Workers Logs (Workers Paid: kept 7 days) and crash alerts by email from the
# worker-error-alerts Tail Worker.
[observability]
enabled = true

[[tail_consumers]]
service = "worker-error-alerts"

[[d1_databases]]
binding = "DB"
database_name = "florence-mae-gifts-admin"
database_id = "YOUR_D1_DATABASE_ID_HERE"

[vars]
ALLOWED_ORIGINS = "https://www.florencemaegifts.com"

# Required secrets (set via `wrangler secret put`): RESEND_API_KEY, ADMIN_PASS, ADMIN_SESSION_SECRET, TOTP_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, TAX_READ_TOKEN, ANTHROPIC_API_KEY (Ask K), TURNSTILE_SECRET, SUMMARY_TOKEN (Ask K daily summary for ESA)
# Optional admin username secret: ADMIN_USER (defaults to "admin" if omitted)
# Optional: map item names to fallback price ids if client doesn't send one.
# Required for shop checkout: set STORE_ALLOWED_PRICE_IDS as a Worker secret (comma-separated price IDs).
# ITEM_PRICE_MAP = '{"Example Item":"price_..."}'
# Map digital item names to private R2 object keys for one-time download links.
DOWNLOAD_FILE_MAP = '{"Four Star Ball Crochet Baby Hat Pattern - Beginner Level (PDF Download Only)":"four-star-ball-crochet-baby-hat-pattern.pdf","Crochet Baby Hat Pattern: Five Point Design (PDF Download Only)":"crochet-baby-hat-pattern-five-point-design.pdf","Gohan Inspired Hat Pattern - Beginner Level (PDF Download Only)":"four-star-ball-crochet-baby-hat-pattern.pdf","Goku Inpsired Baby Hat Pattern - Beginner Level (PDF Download Only)":"crochet-baby-hat-pattern-five-point-design.pdf","Goku Inspired Baby Hat Pattern - Beginner Level (PDF Download Only)":"crochet-baby-hat-pattern-five-point-design.pdf"}'
# One-time link settings.
DOWNLOAD_BASE_URL = "https://www.florencemaegifts.com/api/download"
DOWNLOAD_TOKEN_TTL_SECONDS = "86400"
DOWNLOAD_TOKEN_MAX_USES = "3"
# Outgoing email (src/email.js) goes through Cloudflare Email Sending on
# florencemaegifts.com (the EMAIL binding below); if that fails, the
# RESEND_API_KEY secret (Resend) sends it instead, so the sender must stay
# verified in Resend too.
# Optional: set ORDER_EMAIL_ALERT_TO to route failed order-email/download alerts separately; defaults to CONTACT_TO_EMAIL.
RESEND_FROM_EMAIL = "Florence Mae Gifts <orders@florencemaegifts.com>"
SUPPORT_EMAIL = "contact@florencemaegifts.com"
# Emergency admin sign-in (admin-emergency.html): the one address codes go to,
# and who is told every time it is used. Kept out of git (wrangler.toml is ignored).
EMERGENCY_ADMIN_EMAIL = "megan@example.com"
EMERGENCY_NOTIFY_EMAIL = "chris@example.com"
CONTACT_TO_EMAIL = "contact@florencemaegifts.com"
# Turnstile on the emergency sign-in (admin-emergency.html) and Ask K: hostnames a passed check may
# come from. The widget secret is the TURNSTILE_SECRET Worker secret.
TURNSTILE_HOSTNAMES = "www.florencemaegifts.com"
# Ask K (src/ask-k.js): estimated Claude spend caps in dollars, per Eastern day and
# calendar month, kept under the fmg-ask-k workspace's $30/month limit. The key is the
# ANTHROPIC_API_KEY Worker secret. Alerts go to EMERGENCY_NOTIFY_EMAIL (or ASKK_ALERT_TO).
# Only if the key asks for it: ASKK_ANTHROPIC_WORKSPACE_ID = "<fmg-ask-k workspace ID>"
ASKK_DAILY_BUDGET = "0.75"
ASKK_MONTHLY_BUDGET = "20"

[[send_email]]
name = "EMAIL"
allowed_sender_addresses = ["orders@florencemaegifts.com"]

# Email Sending delivery events for florencemaegifts.com (bounced / failed /
# rejected / spam complaint), delivered by an event subscription on this
# queue. Each one becomes an alert email to CONTACT_TO_EMAIL (src/email-events.js).
[[queues.consumers]]
queue = "florencemaegifts-email-events"
max_batch_size = 10
max_batch_timeout = 30
max_retries = 10

[[r2_buckets]]
binding = "DOWNLOADS_BUCKET"
bucket_name = "YOUR_DOWNLOADS_R2_BUCKET_NAME_HERE"

[[r2_buckets]]
binding = "RECEIPTS"
bucket_name = "YOUR_RECEIPTS_R2_BUCKET_NAME_HERE"

[[kv_namespaces]]
binding = "DOWNLOAD_TOKENS"
id = "YOUR_KV_NAMESPACE_ID_HERE"
